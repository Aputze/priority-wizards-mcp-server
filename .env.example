# Priority Wizards MCP Server — Configuration
# Copy this file to .env and update paths for your environment

# ── Local / STDIO (Windows host paths) ────────────────────────────
# Hebrew wizards (wiz1) — extracted from wiz1.chm
WIZ1_HHC=D:\priority\tmp\chm_extract_wiz1\WIZ1.hhc
WIZ1_DIR=D:\priority\tmp\chm_extract_wiz1

# English wizards (wiz3) — extracted from wiz3.chm
WIZ3_HHC=D:\priority\tmp\chm_extract_wiz3\WIZ3.hhc
WIZ3_DIR=D:\priority\tmp\chm_extract_wiz3

# HTTP Server
PORT=3040
HOST=0.0.0.0

# ── Docker Compose volume mounts (forward slashes) ────────────────
# Used by docker-compose.yml for bind mounts only.
# Inside the container paths are always /data/wiz1 and /data/wiz3.
WIZ1_HOST_DIR=D:/priority/tmp/chm_extract_wiz1
WIZ3_HOST_DIR=D:/priority/tmp/chm_extract_wiz3
